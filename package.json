{
  "name": "sync-sftp",
  "publisher": "vad23klev",
  "displayName": "Sync SFTP",
  "description": "Sync your project with remote using SFTP",
  "icon": "./icons/icon.png",
  "version": "1.0.2",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "url": "https://github.com/vad23klev/sync-sftp"
  },
  "activationEvents": [
    "workspaceContains:**/.sync-sftp.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sync-sftp-view",
          "title": "Sync SFTP",
          "icon": "icons/menu-icon.svg"
        }
      ]
    },
    "views": {
      "sync-sftp-view": [
        {
          "type": "webview",
          "id": "sync-sftp.logView",
          "name": "Sync SFTP",
          "icon": "icons/menu-icon.svg",
          "contextualTitle": "Sync SFTP"
        }
      ]
    },
    "commands": [
      {
        "command": "sync-sftp.reloadConfig",
        "category": "Sync SFTP",
        "title": "Reload Configuration",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sync-sftp.detectDifferences",
        "category": "Sync SFTP",
        "title": "Detect differences",
        "icon": "$(info)"
      },
      {
        "command": "sync-sftp.makeEqual",
        "category": "Sync SFTP",
        "title": "Make equal",
        "icon": "$(remote)"
      },
      {
        "command": "sync-sftp.reconnect",
        "category": "Sync SFTP",
        "title": "Reconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sync-sftp.clearLog",
        "category": "Sync SFTP",
        "title": "Clear",
        "icon": "$(clear-all)"
      },
      {
        "command": "sync-sftp.clearQuery",
        "category": "Sync SFTP",
        "title": "Clear Query",
        "icon": "$(clear-all)"
      },
      {
        "command": "sync-sftp.toggleWatcher",
        "category": "Sync SFTP",
        "title": "Toggle watcher",
        "icon": "$(coffee)"
      },
      {
        "command": "sync-sftp.upload",
        "title": "Sync SFTP: Upload file"
      }
    ],
    "submenus": [
      {
        "id": "sync-sftp.submenu",
        "label": "Sync SFTP"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sync-sftp.clearQuery",
          "group": "navigation@0",
          "when": "view == sync-sftp.logView"
        },
        {
          "command": "sync-sftp.toggleWatcher",
          "group": "navigation@1",
          "when": "view == sync-sftp.logView"
        },
        {
          "command": "sync-sftp.detectDifferences",
          "group": "sync-sftp.submenu@0",
          "when": "view == sync-sftp.logView"
        },
        {
          "command": "sync-sftp.makeEqual",
          "group": "sync-sftp.submenu@1",
          "when": "view == sync-sftp.logView"
        },
        {
          "command": "sync-sftp.clearLog",
          "group": "sync-sftp.submenu@3",
          "when": "view == sync-sftp.logView"
        }
      ],
      "explorer/context": [
        {
          "command": "sync-sftp.upload",
          "group": "sync-sftp"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint",
    "pretest": "npm run lint",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/ping": "^0.4.4",
    "@types/relaxed-json": "^1.0.4",
    "@types/rsync": "^0.4.36",
    "@types/unixify": "^1.0.2",
    "@types/vscode": "^1.73.0",
    "eslint": "^8.57.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "dependencies": {
    "node-ssh": "^13.2.0",
    "node-watch": "^0.7",
    "ping": "^0.4.4",
    "relaxed-json": "^1.0.0",
    "rsync2": "vad23klev/rsync#aa4d2d2",
    "unixify": "^1.0.0"
  }
}
